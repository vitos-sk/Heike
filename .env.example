# Kopie nach .env.local (lokal) bzw. in die Vercel-Umgebungsvariablen eintragen.
# Echte Werte gehören NIE ins Repository.

# --- Datenbank & Bilder (Supabase) ---
SUPABASE_URL=https://<projekt>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- E-Mail (Resend) ---
RESEND_API_KEY=
# Absender: muss eine bei Resend verifizierte Domain sein, z. B. "Heike Schaub <kontakt@deine-domain.de>"
CONTACT_EMAIL_FROM=
# Hierhin gehen die Benachrichtigungen über neue Nachrichten (und Antworten laufen darüber)
CONTACT_EMAIL_TO=Schaub-heike@gmx.de
# Nur zum Testen: alle Mails an diese Adresse umlenken
# TEST_EMAIL_REDIRECT=

# --- Admin-Bereich ---
# Erstanlage des Kontos (danach änderbar im Admin unter "Zugang")
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Geheimer Schlüssel für den privaten Link /admin?key=...
ADMIN_GATE_KEY=
# Zufällige lange Zeichenfolgen (z. B. `openssl rand -base64 48`)
ADMIN_GATE_SECRET=
SESSION_SECRET=

# --- Website ---
NEXT_PUBLIC_SITE_URL=https://www.example.de
